{% extends 'base.html.twig' %}
{% block contenu %}
<h1>Mot de passe oublié</h1>
<form method="post">
  <label for="email">Adresse e-mail du compte</label>
  <input id="email" type="email" name="email" required autocomplete="email">
  <button type="submit">Recevoir un lien</button>
</form>
{% endblock %}
