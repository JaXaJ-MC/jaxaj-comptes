<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titre|default('Compte') }} · JaXaJ MC</title>
<style>
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f2f3f5;color:#1F2933;font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;padding:16px;box-sizing:border-box}
main{background:#fff;max-width:420px;width:100%;padding:28px;border-radius:10px;box-shadow:0 2px 14px rgba(0,0,0,.08)}
h1{font-size:22px;margin:0 0 16px;color:#1F3A5F}
label{display:block;margin:14px 0 4px;font-weight:600}
input{width:100%;box-sizing:border-box;padding:10px;border:1px solid #c9ced6;border-radius:6px;font:inherit}
button{margin-top:20px;width:100%;padding:12px;border:0;border-radius:6px;background:#1F3A5F;color:#fff;font:inherit;font-weight:600;cursor:pointer}
.erreur{color:#b42318;margin-top:12px}.doux{color:#6b7785;font-size:14px}a{color:#1F3A5F}
</style>
</head>
<body><main>{% block contenu %}{% endblock %}</main></body>
</html>
